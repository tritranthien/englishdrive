# Store as /etc/englishdrive.env on the VPS, mode 600.
# Use a random hexadecimal password to avoid URL escaping issues.
POSTGRES_PASSWORD=replace_with_random_hex
JWT_SECRET=replace_with_at_least_32_random_characters
GEMINI_API_KEY=
# Optional text chat model; empty uses GEMINI_ANALYSIS_MODEL.
GEMINI_CHAT_MODEL=
# Enable after deploying and testing chat. Separate from the user's own preferences.
CHAT_PROACTIVE_ENABLED=false
# Firebase service account on the VPS, readable by container uid/gid 1000.
# GOOGLE_APPLICATION_CREDENTIALS=/run/englishdrive-secrets/firebase-service-account.json
# Bind locally until an HTTPS reverse proxy is configured.
API_BIND_ADDRESS=127.0.0.1
# Optional admin dashboard. Use a bcrypt hash enclosed in single quotes.
# ADMIN_PASSWORD_HASH='$2b$12$...'
# Enable after switching the dashboard to HTTPS:
# ADMIN_COOKIE_SECURE=true
# Required to edit API keys in the dashboard: openssl rand -hex 32
# API_KEYS_ENCRYPTION_KEY=64_hex_characters
