generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiKeySetting {
  provider       String   @id
  encryptedValue String
  updatedAt      DateTime @updatedAt
}

enum EnglishLevel {
  A1
  A2
  B1
  B2
  C1
  C2
  UNKNOWN
}

enum LanguageMode {
  BEGINNER
  INTERMEDIATE
  IMMERSION
}

enum CorrectionMode {
  IMPORTANT_ONLY
  FREQUENT
  ON_REQUEST
}

enum SessionType {
  COMMUTE
  FREE_TALK
  PRACTICE
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  FAILED
}

enum TranscriptRole {
  USER
  ASSISTANT
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id              String                @id @default(uuid())
  email           String                @unique
  passwordHash    String
  name            String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  profile         LearningProfile?
  sessions        ConversationSession[]
  mistakes        Mistake[]
  vocabulary      VocabularyItem[]
  vocabularyDecks VocabularyDeck[]
  chatCharacters  ChatCharacter[]
  chatThreads     ChatThread[]
  chatPreferences ChatPreferences?
  chatDevices     ChatDevice[]
  videoLessons    VideoLesson[]
}

model ChatCharacter {
  id            String        @id @default(uuid())
  userId        String
  templateId    String?
  name          String
  age           Int
  gender        String
  occupation    String
  bio           String
  personality   String
  interests     String
  speakingStyle String
  color         String        @default("#55ddb6")
  archived      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberships   ChatMember[]
  messages      ChatMessage[]

  @@unique([userId, templateId])
  @@index([userId, archived])
}

model ChatPreferences {
  userId      String   @id
  enabled     Boolean  @default(true)
  autoCorrect Boolean  @default(true)
  minMinutes  Int      @default(120)
  maxMinutes  Int      @default(360)
  dailyLimit  Int      @default(6)
  quietStart  Int      @default(22)
  quietEnd    Int      @default(8)
  timezone    String   @default("Asia/Ho_Chi_Minh")
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatThread {
  id                String        @id @default(uuid())
  userId            String
  kind              String
  title             String
  directCharacterId String?
  romance           Boolean       @default(false)
  archived          Boolean       @default(false)
  muted             Boolean       @default(false)
  proactiveEnabled  Boolean       @default(true)
  minMinutes        Int?
  maxMinutes        Int?
  nextProactiveAt   DateTime
  unattendedRounds  Int           @default(0)
  lastReadSequence  Int           @default(0)
  lastSequence      Int           @default(0)
  repliedThrough    Int           @default(0)
  typingUntil       DateTime?
  memory            String        @default("")
  memoryThrough     Int           @default(0)
  revision          Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  members           ChatMember[]
  messages          ChatMessage[]
  jobs              ChatJob[]

  @@unique([userId, directCharacterId])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([archived, nextProactiveAt])
}

model ChatMember {
  threadId    String
  characterId String
  thread      ChatThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  character   ChatCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([threadId, characterId])
}

model ChatMessage {
  id              String         @id @default(uuid())
  threadId        String
  sequence        Int
  clientMessageId String?
  characterId     String?
  role            String
  content         String
  createdAt       DateTime       @default(now())
  thread          ChatThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  character       ChatCharacter? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@unique([threadId, sequence])
  @@unique([threadId, clientMessageId])
}

model ChatJob {
  id              String     @id @default(uuid())
  threadId        String
  key             String     @unique
  kind            String
  status          String     @default("PENDING")
  triggerSequence Int        @default(0)
  dueAt           DateTime
  attempts        Int        @default(0)
  leaseUntil      DateTime?
  leaseToken      String?
  payload         Json?
  error           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  thread          ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([status, dueAt])
  @@index([threadId, kind, createdAt])
}

model ChatDevice {
  id             String   @id @default(uuid())
  userId         String
  token          String   @unique
  installationId String   @unique
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LearningProfile {
  id                String         @id @default(uuid())
  userId            String         @unique
  level             EnglishLevel   @default(UNKNOWN)
  preferredLanguage String         @default("vi")
  languageMode      LanguageMode   @default(INTERMEDIATE)
  englishRatio      Float          @default(0.8)
  correctionMode    CorrectionMode @default(IMPORTANT_ONLY)
  conversationStyle String         @default("friendly")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConversationSession {
  id              String              @id @default(uuid())
  userId          String
  type            SessionType
  provider        String?
  model           String?
  startedAt       DateTime            @default(now())
  endedAt         DateTime?
  durationSeconds Int?
  status          SessionStatus       @default(ACTIVE)
  summary         String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcript      TranscriptMessage[]
  analysis        SessionAnalysis?
  mistakes        SessionMistake[]
  vocabulary      SessionVocabulary[]

  @@index([userId, startedAt(sort: Desc)])
  @@index([userId, status])
}

model TranscriptMessage {
  id              String              @id @default(uuid())
  sessionId       String
  clientMessageId String
  role            TranscriptRole
  content         String
  occurredAt      DateTime
  createdAt       DateTime            @default(now())
  session         ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, clientMessageId])
  @@index([sessionId, occurredAt])
}

model SessionAnalysis {
  id                String              @id @default(uuid())
  sessionId         String              @unique
  status            AnalysisStatus      @default(PENDING)
  provider          String              @default("gemini")
  model             String
  summary           String?
  mainTopics        Json?
  grammarIssues     Json?
  newVocabulary     Json?
  strengths         Json?
  recommendedTopics Json?
  nextSessionFocus  Json?
  errorMessage      String?
  attempts          Int                 @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  memoryUpdatedAt   DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  session           ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

model Mistake {
  id               String           @id @default(uuid())
  userId           String
  patternKey       String
  pattern          String
  latestOriginal   String
  latestSuggestion String
  explanationVi    String
  occurrenceCount  Int              @default(0)
  firstSeenAt      DateTime         @default(now())
  lastSeenAt       DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions         SessionMistake[]

  @@unique([userId, patternKey])
  @@index([userId, occurrenceCount, lastSeenAt(sort: Desc)])
}

model SessionMistake {
  sessionId     String
  mistakeId     String
  original      String
  suggestion    String
  explanationVi String
  createdAt     DateTime            @default(now())
  session       ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  mistake       Mistake             @relation(fields: [mistakeId], references: [id], onDelete: Cascade)

  @@id([sessionId, mistakeId])
  @@index([mistakeId])
}

model VocabularyItem {
  id              String              @id @default(uuid())
  userId          String
  deckId          String?
  termKey         String
  pinned          Boolean             @default(false)
  term            String
  meaningVi       String
  example         String
  familiarity     Float               @default(0.2)
  occurrenceCount Int                 @default(0)
  reviewCount     Int                 @default(0)
  correctCount    Int                 @default(0)
  firstSeenAt     DateTime            @default(now())
  lastSeenAt      DateTime            @default(now())
  nextReviewAt    DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck            VocabularyDeck?     @relation(fields: [deckId], references: [id], onDelete: SetNull)
  sessions        SessionVocabulary[]

  @@unique([userId, termKey])
  @@index([userId, deckId])
  @@index([userId, nextReviewAt, lastSeenAt(sort: Desc)])
}

model VocabularyDeck {
  id        String           @id @default(uuid())
  userId    String
  name      String
  nameKey   String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  words     VocabularyItem[]

  @@unique([userId, nameKey])
  @@index([userId, createdAt])
}

model SessionVocabulary {
  sessionId        String
  vocabularyItemId String
  createdAt        DateTime            @default(now())
  session          ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  vocabularyItem   VocabularyItem      @relation(fields: [vocabularyItemId], references: [id], onDelete: Cascade)

  @@id([sessionId, vocabularyItemId])
  @@index([vocabularyItemId])
}

enum VideoSourceType {
  YOUTUBE
  DIRECT
}

enum VideoSubtitleStatus {
  PROCESSING
  READY
  FAILED
}

model VideoLesson {
  id               String              @id @default(uuid())
  userId           String
  url              String
  sourceType       VideoSourceType
  externalId       String?
  title            String
  thumbnailUrl     String?
  durationSeconds  Int?
  processedUntilMs Int                 @default(0)
  status           VideoSubtitleStatus @default(PROCESSING)
  subtitles        Json?
  errorMessage     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}
